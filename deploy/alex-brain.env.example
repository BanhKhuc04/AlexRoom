# Copy to /etc/alex/alex-brain.env and set a strong private value.
ALEX_BRAIN_API_KEY=

ALEX_BRAIN_PROVIDER=ollama_native
ALEX_BRAIN_PROVIDER_URL=http://127.0.0.1:11434
ALEX_BRAIN_MODEL=qwen3.5:2b
ALEX_BRAIN_PROVIDER_API_KEY=

# Normal inference must fail before the Core's 30-second request budget.
ALEX_BRAIN_PROVIDER_TIMEOUT_SECONDS=25

# Startup-only cold loading is measured separately and may take ~46.66 seconds.
ALEX_BRAIN_WARMUP_TIMEOUT_SECONDS=60

# Production Speech-to-Text (STT) FasterWhisper configuration.
# Production candidate: model=small.
# (Note: 'medium' model was rejected in Brain PC benchmark due to excessive latency ~12-18s and heavy swap pressure).
ALEX_STT_MODEL=small
ALEX_STT_LANGUAGE=vi
ALEX_STT_DEVICE=cpu
ALEX_STT_COMPUTE_TYPE=int8

# Real Piper TTS Production Configuration
ALEX_TTS_PROVIDER=piper
ALEX_PIPER_BACKEND=python
ALEX_PIPER_VOICE=vi_VN-vais1000-medium
ALEX_PIPER_MODEL_DIR=/var/lib/alex-brain/models/piper
ALEX_TTS_NAME_PRONUNCIATION=A-lếch

